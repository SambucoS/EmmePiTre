<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.ModifyPlaylistController"
      spacing="15"
      alignment="CENTER"
      prefWidth="400"
      prefHeight="220"
      style="-fx-background-color: #f7f7f7;">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Modifica playlist"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label fx:id="currentPlaylistNameLabel"
           text=""
           style="-fx-font-size: 14px;"/>

    <TextField fx:id="newPlaylistNameField"
               promptText="Nuovo nome playlist"
               prefWidth="300"/>

    <Label fx:id="messageLabel"
           text=""
           style="-fx-font-size: 12px;"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Annulla"
                onAction="#handleCancel"
                prefWidth="100"/>

        <Button text="Salva"
                onAction="#handleSave"
                prefWidth="100"
                style="-fx-background-color: #6c5ce7; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

</VBox>