<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

                <HBox fx:id="mainBar" prefHeight="25.0" prefWidth="200.0">
                        <Label fx:id="titleBar" alignment="CENTER" prefHeight="36.0" prefWidth="219.0" text="EmmePiTre" wrapText="true">
                            <font>
                                <Font name="System Bold Italic" size="25.0" />
                            </font>
                        </Label>
                        <Region prefHeight="36.0" prefWidth="100.0" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="researchBar" prefHeight="35.0" prefWidth="178.0" promptText="What vibes are we looking for?" />
                </HBox>
                <TableView fx:id="trackList" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="titleColumn" prefWidth="75.0" text="Title" />

                        <TableColumn fx:id="authorColumn" prefWidth="75.0" text="Author" />
                        <TableColumn fx:id="albumColumn" prefWidth="75.0" text="Album" />

                        <TableColumn fx:id="genreColumn" prefWidth="75.0" text="Genre" />
                        <TableColumn fx:id="lengthColumn" prefWidth="75.0" text="Length" />
                    </columns>
                </TableView>
        </VBox>
</AnchorPane>