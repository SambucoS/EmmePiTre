<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.PlaylistController"
      spacing="15"
      alignment="CENTER"
      prefWidth="450"
      prefHeight="400"
      style="-fx-background-color: #f7f7f7;">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Rimuovi traccia da playlist"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label text="Seleziona una playlist:"/>

    <ComboBox fx:id="playlistComboBox"
              promptText="Playlist"
              prefWidth="320"/>

    <Label text="Seleziona la traccia da rimuovere:"/>

    <ListView fx:id="playlistTracksListView"
              prefWidth="320"
              prefHeight="160"/>

    <Label fx:id="messageLabel"
           text=""
           style="-fx-font-size: 12px;"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Annulla"
                onAction="#handleCancelRemove"
                prefWidth="100"/>

        <Button text="Rimuovi"
                onAction="#handleRemoveTrackFromPlaylist"
                prefWidth="120"
                style="-fx-background-color: #d63031; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

</VBox>