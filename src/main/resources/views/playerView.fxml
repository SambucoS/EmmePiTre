<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="700.0" spacing="15.0" style="-fx-border-color: black; -fx-border-width: 1px;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PlayerController">
    <padding>
        <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
    </padding>
    <children>

        <Label fx:id="tnameLbl" prefWidth="150.0" text="Nome Traccia.mp3" />

        <Region HBox.hgrow="ALWAYS" />

        <VBox alignment="CENTER" prefWidth="350.0" spacing="8.0">
            <children>
                <HBox alignment="CENTER" spacing="15.0">
                    <Button fx:id="prevButton" onAction="#handlePrev" text="⏮ Prev" />
                    <Button fx:id="statusButton" onAction="#handleStatus" text="Play" />
                    <Button fx:id="nextButton" onAction="#handleNext" text="Next ⏭" />
                </HBox>
                <HBox alignment="CENTER" spacing="8.0">
                    <children>
                        <Label text="00:00" />
                        <Slider fx:id="progressSlider" HBox.hgrow="ALWAYS" />
                        <Label fx:id="durationLbl" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER" prefWidth="200.0"><Label alignment="CENTER_RIGHT" prefWidth="150.0" text="Volume" /> <Slider /></HBox>
      <Separator orientation="VERTICAL" prefHeight="200.0" />


    </children>
</HBox>
