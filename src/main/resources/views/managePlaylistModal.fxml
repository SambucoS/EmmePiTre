<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.ManagePlaylistModalController"
      spacing="14"
      prefWidth="500"
      prefHeight="560"
      style="-fx-background-color: -app-bg;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Titolo -->
    <Label text="📁 Gestisci Playlist" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <!-- Sezione rinomina -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Nome playlist:" minWidth="110"/>
        <TextField fx:id="renameField"
                   prefWidth="330"
                   promptText="Nome della playlist"/>
    </HBox>

    <!-- Separatore visivo -->
    <Label text="Tracce della libreria:"
           style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 4 0 0 0;"/>

    <!-- Lista tracce con checkbox — VBox.vgrow fa espandere la lista -->
    <ListView fx:id="trackListView"
              VBox.vgrow="ALWAYS"
              prefHeight="380"
              style="-fx-background-color: -app-bg;
                     -fx-border-color: -app-border;
                     -fx-border-radius: 4;
                     -fx-background-radius: 4;"/>

    <!-- Pulsanti -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="✖ Annulla"
                onAction="#onCancel"
                prefWidth="100"
                style="-fx-background-color: #aaaaaa; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button text="✔ Salva"
                onAction="#onSave"
                prefWidth="100"
                style="-fx-background-color: #1DB954; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

</VBox>
