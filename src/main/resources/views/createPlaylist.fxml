<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.PlaylistController"
      spacing="15"
      alignment="CENTER"
      prefWidth="400"
      prefHeight="250"
      style="-fx-background-color: -app-bg;">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Crea nuova playlist"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label text="Inserisci il nome della playlist:"
           style="-fx-font-size: 14px;"/>

    <TextField fx:id="playlistNameField"
               promptText="Nome playlist"
               maxWidth="300"
               onAction="#handleCreatePlaylist"/>

    <Label fx:id="messageLabel"
           text=""
           style="-fx-font-size: 12px;"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Annulla"
                onAction="#handleCancel"
                prefWidth="100"/>

        <Button text="Crea"
                onAction="#handleCreatePlaylist"
                prefWidth="100"
                defaultButton="true"
                style="-fx-background-color: #6c5ce7; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <Button text="Playlist automatica"
                onAction="#handleAutomaticPlaylist"
                prefWidth="150"
                style="-fx-background-color: #1DB954; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

</VBox>