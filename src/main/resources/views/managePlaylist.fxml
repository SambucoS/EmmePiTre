<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.PlaylistController"
      spacing="15"
      prefWidth="700"
      prefHeight="500"
      style="-fx-background-color: #f7f7f7;">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Gestione Playlist"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <!-- Sezione superiore: selezione playlist e rinomina -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Playlist:"/>

        <ComboBox fx:id="playlistComboBox"
                  promptText="Seleziona playlist"
                  prefWidth="250"/>

        <TextField fx:id="renamePlaylistField"
                   promptText="Nuovo nome playlist"
                   prefWidth="220"/>

        <!-- Per ora il bottone è solo grafico: la logica di rinomina verrà aggiunta dopo -->
        <Button text="Rinomina"
                prefWidth="100"/>
    </HBox>

    <!-- Area centrale divisa in due colonne -->
    <HBox spacing="20" alignment="CENTER">

        <!-- Colonna sinistra: elenco tracce presenti nella playlist selezionata -->
        <VBox spacing="10" prefWidth="320">
            <Label text="Tracce nella playlist:"
                   style="-fx-font-weight: bold;"/>

            <ListView fx:id="playlistTracksListView"
                      prefWidth="320"
                      prefHeight="260"/>

            <Button text="Rimuovi traccia"
                    onAction="#handleRemoveTrackFromPlaylist"
                    prefWidth="150"
                    style="-fx-background-color: #d63031; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Colonna destra: form grafico per aggiungere una traccia alla playlist -->
        <VBox spacing="10" prefWidth="320">
            <Label text="Aggiungi traccia:"
                   style="-fx-font-weight: bold;"/>

            <TextField fx:id="trackTitleField"
                       promptText="Titolo"
                       prefWidth="300"/>

            <TextField fx:id="trackArtistField"
                       promptText="Artista"
                       prefWidth="300"/>

            <TextField fx:id="trackAlbumField"
                       promptText="Album"
                       prefWidth="300"/>

            <TextField fx:id="trackGenreField"
                       promptText="Genere"
                       prefWidth="300"/>

            <TextField fx:id="trackYearField"
                       promptText="Anno"
                       prefWidth="300"/>

            <TextField fx:id="trackDurationField"
                       promptText="Durata in secondi"
                       prefWidth="300"/>

            <!-- Per ora il bottone è solo grafico: la logica verrà aggiunta dalla parte di popolamento playlist -->
            <Button text="Aggiungi traccia"
                    prefWidth="150"
                    style="-fx-background-color: #6c5ce7; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>

    </HBox>

    <!-- Messaggi di conferma o errore -->
    <Label fx:id="messageLabel"
           text=""
           style="-fx-font-size: 12px;"/>

    <!-- Pulsante di chiusura/annullamento della schermata -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annulla"
                onAction="#handleCancelRemove"
                prefWidth="100"/>
    </HBox>

</VBox>