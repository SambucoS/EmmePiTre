<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="450" prefWidth="700" spacing="15" style="-fx-background-color: #f7f7f7;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PlaylistController">

    <padding>
        <Insets bottom="25" left="25" right="25" top="25" />
    </padding>

    <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Gestione Playlist" />

    <!-- Selezione playlist -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Playlist:" />

        <ComboBox fx:id="playlistComboBox" prefWidth="250" promptText="Seleziona playlist" />

        <!-- TextField = campo in cui scrivere il nuovo nome -->
        <TextField fx:id="renamePlaylistField" prefWidth="220" promptText="Nuovo nome playlist" />

        <!-- Per ora il bottone è solo grafico: non ha onAction -->
        <Button prefWidth="100" text="Rinomina" />
    </HBox>

    <!-- Area centrale divisa in due colonne -->
    <HBox alignment="CENTER" spacing="20">

        <!-- Colonna sinistra: elenco tracce presenti nella playlist -->
        <VBox prefWidth="320" spacing="10">
            <Label style="-fx-font-weight: bold;" text="Tracce nella playlist:" />

            <ListView fx:id="playlistTracksListView" prefHeight="230" prefWidth="320" />

            <Button onAction="#handleRemoveTrackFromPlaylist" prefWidth="150" style="-fx-background-color: #d63031; -fx-text-fill: white; -fx-font-weight: bold;" text="Rimuovi traccia" />
        </VBox>

        <!-- Colonna destra: form per aggiungere una traccia -->
        <VBox prefWidth="320" spacing="10">
            <Label style="-fx-font-weight: bold;" text="Aggiungi traccia:" />

            <TextField fx:id="trackTitleField" prefWidth="300" promptText="Titolo" />

            <TextField fx:id="trackArtistField" prefWidth="300" promptText="Artista" />

            <TextField fx:id="trackAlbumField" prefWidth="300" promptText="Album" />

            <TextField fx:id="trackGenreField" prefWidth="300" promptText="Genere" />

            <TextField fx:id="trackYearField" prefWidth="300" promptText="Anno" />

            <TextField fx:id="trackDurationField" prefWidth="300" promptText="Durata in secondi" />

            <!-- Anche questo bottone può rimanere solo grafico per ora -->
            <Button fx:id="buttonAggiungiTraccia" onAction="#handleAggiungiTraccia" prefWidth="150" style="-fx-background-color: #6c5ce7; -fx-text-fill: white; -fx-font-weight: bold;" text="Aggiungi traccia" />
        </VBox>

    </HBox>

    <Label fx:id="messageLabel" style="-fx-font-size: 12px;" text="" />

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button onAction="#handleCancelRemove" prefWidth="100" text="Annulla" />
    </HBox>

</VBox>
