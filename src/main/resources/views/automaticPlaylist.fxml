<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AutomaticPlaylistController"
      spacing="15"
      alignment="CENTER"
      prefWidth="420"
      prefHeight="260"
      style="-fx-background-color: #f7f7f7;">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Playlist automatica"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label text="Scegli il criterio di generazione:"
           style="-fx-font-size: 14px;"/>

    <ComboBox fx:id="criteriaComboBox"
              promptText="Seleziona criterio"
              prefWidth="300"/>

    <ComboBox fx:id="valueComboBox"
              promptText="Seleziona valore"
              prefWidth="300"/>

    <Label fx:id="messageLabel"
           text=""
           style="-fx-font-size: 12px;"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Annulla"
                onAction="#handleCancel"
                prefWidth="100"/>

        <Button text="Genera"
                onAction="#handleGenerate"
                prefWidth="100"
                defaultButton="true"
                style="-fx-background-color: #1DB954; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

</VBox>